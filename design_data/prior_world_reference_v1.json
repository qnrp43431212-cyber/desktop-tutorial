  "glossary": {
    "강호": "무림인·상인·유랑민·정보망 등이 활동하는 사회적 공간",
    "무림": "강호 내 무인과 무공 조직을 중심으로 한 공동체",
    "협": "약자를 돕고 신의를 지키는 협객의 정신",
    "정파": "자신들이 정통을 계승한다고 주장하는 무림 조직군",
    "사파": "정파와 다른 이해관계나 무공 전통을 지닌 조직군",
    "마교": "무협소설에서 쓰이는 독립적 교단형 세력의 이미지",
    "문파": "사제 관계·무학을 전수하는 무인 조직",
    "세가": "혈통과 가업을 중심으로 존속하는 무인 가문",
    "장문인": "문파 수장",
    "가주": "가문 수장",
    "방주": "방/길드 수장",
    "교주": "교단 수장",
    "표국": "호위와 운송을 업으로 하는 조직",
    "비급": "무공의 원리를 기록한 희귀 문헌",
    "심법": "마음과 기운 운용을 가르치는 수련법",
    "내공": "무협에서 신체 내부의 기운을 축적·운용하는 수행",
    "경공": "빠른 이동과 고도약을 하는 무술의 문학적 범주",
    "보법": "발의 움직임·거리 조절을 다루는 기술",
    "진법": "협동 진형·지형 배치를 이용하는 기술",
    "기연": "우연한 인연으로 얻는 희귀한 기회",
    "주화입마": "무리한 수련과 심신 혼란의 장르적 결과",
    "은원": "은혜와 원한에 얽힌 관계",
    "별호": "강호에서 주어지는 인물의 이름 또는 명칭",
    "검기": "검에 실리거나 검에서 발산되는 장르적 기운",
    "검강": "검기보다 한층 압축·응집된 기술의 소설적 이미지",
    "단전": "기를 모으는 자리라는 전통 사상과 무협의 개념"
